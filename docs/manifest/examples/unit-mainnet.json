  "runtime": {
    "engine": "hermes-agent",
    "adapter": "agenft-run-turn/v1",
    "hosting": { "primary": "local", "fallbacks": ["akash", "vps"] }
  },

  "organs": {
    "brain": {
      "primary": {
        "provider": "tx402.ai",
        "endpoint": "https://tx402.ai/v1/chat/completions",
        "model": "minimax/minimax-m3",
        "network": "eip155:8453"
      },
      "fallbacks": [],
      "routing": { "priority": ["sovereign", "opportunistic", "hose", "dormant"] }
    },
    "memory": {
      "format": "agenft-memory-capsule/v1",
      "transferPolicy": "owner-choice-at-transfer",
      "vault0NeverOnChain": true,
      "operational": {
        "provider": "kubo",
        "primary": null,
        "fallbacks": ["lab-remote", "w3stor", "ipfs"]
      },
      "archive": { "provider": "arweave", "primary": null }
    },
    "doctor": {
      "enabled": true,
      "probeIntervalSec": 900,
      "autoFailover": true,
      "autoTransplant": ["brain", "memory"],
      "requireOwnerApproval": ["runtime", "treasury"],
      "maxTransplantsPerDay": 3
    },
    "reflexes": {
      "circuitBreaker": { "maxRequestsPerMinute": 10, "maxTxPerMinute": 3 },
      "allowedContracts": []
    },
    "hands": { "enabled": [], "dex": "aerodrome" }
  },

  "budget": {
    "currency": "USD",
    "profile": "conversational",
    "minOperatingBalanceUsdc": "5.00",
    "organs": {
      "brain": {
        "limits": {
          "perDay": { "requests": 200, "usd": "1.00" },
          "perMonth": { "usd": "25.00" }
        },
        "onCapExceeded": "degrade_to_cheapest_then_dormant",
        "assumptions": { "avgCostPerRequestUsd": 0.002 }
      },
      "gas": {
        "limits": { "perDay": { "usd": "0.50" } },
        "onCapExceeded": "pause_non_vital_tx"
      }
    },
    "global": {
      "perDayUsdHardCap": "2.00",
      "onGlobalCapExceeded": "dormant_except_doctor_probes"
    }
  },

  "gateways": {
    "policy": {
      "priority": "sovereign-first",
      "recommended": ["nostr", "matrix", "telegram"],
      "sovereignDefault": ["nostr", "matrix"]
    },
    "chat": [
      { "platform": "telegram", "enabled": true, "handle": "Unit1_agent_bot", "credentials": "runtime-only", "sovereign": false }
    ]
  },

  "x402Support": true,
  "supportedTrust": ["reputation"],

  "body": {
    "model": "compact-core",
    "core": ["identity", "treasury", "soul", "reflexes", "budget", "visual"],
    "cables": ["brain", "memory", "gateways", "runtime", "presence", "doctor"]
  },

  "transfer": {
    "vault0NeverTravels": true,
    "transferEndsBotAccess": true,
    "gateways": {
      "telegram": {
        "binding": "owner-vault0",
        "onOwnerChange": "invalidate-and-rebind",
        "policy": "new-bot-only"
      }
    },
    "runtimeGate": {
      "requireOwnerOfMatch": true,
      "onMismatch": "dormant_refuse_turns"
    }
  }
}

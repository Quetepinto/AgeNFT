{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenft.dev/schemas/trip-intent.schema.json",
  "title": "TripIntent",
  "description": "TRNXP — intención de viaje A→B parseada (reglas; LLM opcional off por defecto).",
  "type": "object",
  "required": ["origin", "destination", "when", "criteria", "modesAllowed", "cityPackId", "locale", "confidence"],
  "properties": {
    "origin": { "$ref": "#/$defs/placeRef" },
    "destination": { "$ref": "#/$defs/placeRef" },
    "when": {
      "type": "object",
      "required": ["type", "tz"],
      "description": "leaveNow (=salir ahora) · departAt · arriveBy. Aliases booleanos leaveNow/departAt/arriveBy.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["leaveNow", "departAt", "arriveBy", "depart_now", "depart_at", "arrive_by"]
        },
        "iso": { "type": ["string", "null"], "description": "Instante local ISO para departAt/arriveBy" },
        "tz": { "type": "string" },
        "leaveNow": { "type": "boolean" },
        "departAt": { "type": "boolean" },
        "arriveBy": { "type": "boolean" }
      }
    },
    "criteria": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "string",
          "enum": ["fastest", "fewest_transfers", "cheapest", "least_walking", "most_comfortable", "eco"]
        },
        "secondary": { "type": "array", "items": { "type": "string" } },
        "weights": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "modesAllowed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["walk", "bike", "bus", "metro", "tram", "rail", "taxi", "car", "ferry", "flight"]
      }
    },
    "modesForbidden": { "type": "array", "items": { "type": "string" } },
    "constraints": {
      "type": "object",
      "properties": {
        "maxWalkMeters": { "type": ["number", "null"] },
        "maxTransfers": { "type": ["integer", "null"] },
        "accessibility": { "type": "boolean" },
        "luggage": { "type": "boolean" },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cityPackId": { "type": "string" },
    "locale": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needsClarify": { "type": "array", "items": { "type": "string" } },
    "rawText": { "type": ["string", "null"] },
    "llmUsed": { "type": "boolean", "default": false }
  },
  "$defs": {
    "placeRef": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "lat": { "type": ["number", "null"] },
        "lon": { "type": ["number", "null"] },
        "stopHint": { "type": ["string", "null"] },
        "placeId": { "type": ["string", "null"] }
      }
    }
  }
}

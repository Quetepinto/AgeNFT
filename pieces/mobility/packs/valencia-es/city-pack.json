  "discovery": {
    "allowed": true,
    "policy": "official-first",
    "writeBack": "propose-diff",
    "notes": "Buscadores desde VPS devuelven ruido; ir a la web oficial del operador. Si la web embebe un iframe, mirar de dónde saca los datos (caso Met Go → api.softoursistemas.com)."
  },
  "networks": {
    "metrobus": {
      "name": "MetroBus (Met Go / ATMV)",
      "mode": "bus",
      "scope": "interurban",
      "operator": "Generalitat Valenciana / Softour Sistemas",
      "keywords": ["metrobus", "met go", "112", "112a", "112b", "suecia", "suècia", "el puig bus", "port saplatja", "interurbano", "ricardo micó"],
      "live": {
        "adapter": "softour-metrobus",
        "base": "https://api.softoursistemas.com/metrobus",
        "note": "GET /estimacion/ocupacion/{stop_code} → minutos, ocupación, GPS. Catálogo: GET /old/stops"
      },
      "scheduled": [
        { "type": "pdf", "url": "https://metgovalencia.com/", "note": "PDF por línea enlazado en la home (Linea_112.pdf). Solo publica hora en 3 paradas." },
        { "type": "gtfs", "url": "https://dadesobertes.gva.es/api/3/action/package_show?id=tra-hyr-atmv-horaris-i-rutes", "note": "Excluye zona metropolitana: la L112 NO está aquí." },
        { "type": "planner", "url": "https://gvenruta.gva.es", "note": "Planificador multimodal oficial (pruebas)" }
      ],
      "stops": {
        "168": { "name": "Blasco Ibáñez - Suècia", "lines": ["112A", "114A", "116A", "116B"], "direction": "→ El Puig", "lat": 39.476261, "lon": -0.356927 },
        "166": { "name": "Blasco Ibáñez - Facultat de Geografia i Història", "lines": ["112A"], "lat": 39.477482, "lon": -0.361295 }
      },
      "pitfalls": [
        "stop_code Met Go ≠ código de parada EMT (168 Met Go no es 169 EMT).",
        "«112» en Madrid es EMT Madrid; «112A» València es MetroBus.",
        "minutesToArrival 0 = llegando o en parada, no «no pasa».",
        "La misma parada devuelve otras líneas (114A, 116A); filtrar por la línea preguntada."
      ]
    },
    "emt": {
      "name": "EMT València (urbano)",
      "mode": "bus",
      "scope": "urban",
      "operator": "EMT València",
      "keywords": ["emt", "urbano", "l30", "l31", "l81", "l93", "169", "1085", "1211", "bèlgica", "belgica"],
      "live": {
        "adapter": "transitapp-bgtfs",
        "base": "https://bgtfs.transitapp.com/v4/public/stop_departures",
        "linePage": "https://transitapp.com/en/region/val%C3%A8ncia/emt/bus-{line}",
        "note": "emtvalencia.es bloquea el VPS (firewall). TransitApp expone el feed oficial; is_real_time marca ⚡."
      },
      "scheduled": [
        { "type": "web", "url": "https://www.emtvalencia.es", "note": "No accesible desde VPS" }
      ],
      "stops": {
        "169": { "name": "Blasco Ibáñez / Bèlgica", "lines": ["30", "31", "71", "81"], "lat": 39.475828, "lon": -0.354836, "globalIds": { "30": "EMTVCES:3028", "31": "EMTVCES:3031", "81": "EMTVCES:5319" } },
        "1085": { "name": "Aragó / Xile", "lines": ["10", "12", "93"], "lat": 39.470171, "lon": -0.358289, "globalIds": { "10": "EMTVCES:4440", "12": "EMTVCES:4440" } },
        "764": { "name": "Plaça d'Amèrica / Pont d'Aragó", "lines": ["4", "10", "23"], "globalIds": { "4": "EMTVCES:4312", "10": "EMTVCES:1313", "23": "EMTVCES:4312" } },
        "1211": { "name": "Blasco Ibáñez (imparell) / José María Haro", "lines": ["31", "81"], "lat": 39.471214, "lon": -0.337308, "globalIds": { "31": "EMTVCES:4837", "81": "EMTVCES:2949" } }
      },
      "pitfalls": [
        "TransitApp renumera: EMTVCES:169 NO es la parada EMT 169. Una parada física tiene un global_stop_id distinto por línea.",
        "Blasco Ibáñez tiene paradas por sentido (parell/imparell): indicar siempre la dirección."
      ]
    },
    "renfe-c6": {
      "name": "Cercanías València C6",
      "mode": "rail",
      "scope": "regional",
      "operator": "Renfe",
      "keywords": ["c6", "cercanías", "cercanias", "tren", "renfe", "cabanyal", "nord", "el puig tren", "estació del nord"],
      "live": {
        "adapter": "radardetrenes",
        "base": "https://radardetrenes.com/api/v1/stations/{station}/board-renfe",
        "lineFilter": "C6",
        "note": "~30 s de retraso. Máx 20 salidas. renfe.com y WS ADIF bloqueados desde VPS."

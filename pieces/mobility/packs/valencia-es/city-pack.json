    "metrovalencia": {
      "name": "Metrovalencia (FGV)",
      "mode": "metro",
      "scope": "urban",
      "operator": "FGV",
      "keywords": ["metro", "l3", "l4", "metrovalencia", "fgv", "tranvía", "tranvia"],
      "live": null,

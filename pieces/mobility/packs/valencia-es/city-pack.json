      "scheduled": [
        { "type": "web", "url": "https://www.renfe.com/es/es/cercanias/cercanias-valencia", "note": "403 desde VPS; patrón C6 :23 y :57 cada 30 min hacia València" }
      ],
      "stops": {
        "65007": { "name": "El Puig", "direction": "→ València (trenes que paran en Cabanyal)" },
        "65003": { "name": "València-Cabanyal", "direction": "→ El Puig" },
        "65000": { "name": "València-Estació del Nord" }
      },
      "pitfalls": [
        "Tren con hora estimada superada que sigue en lista = retrasado en camino, no fantasma."
      ]
